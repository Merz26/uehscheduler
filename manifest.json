{
  "manifest_version": 3,
  "key": "",
  "name": "UEH Schedule Sync - Lịch học UEH",
  "version": "1.2.0",
  "short_name": "UEH Schedule",
  "description": "Bilingual extension for UEH students to sync schedules directly with Google Calendar.",
  "action": {
    "default_popup": "extension/popup.html"
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "*://student.ueh.edu.vn/*",
    "*://online.ueh.edu.vn/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "1068393903577-5g3l76neofv7fgdtkshfpcqcf9rprh1n.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "web_accessible_resources": []
}
